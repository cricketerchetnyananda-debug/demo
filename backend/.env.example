# Copy to .env and fill in real values. Never commit .env.
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Either set DATABASE_URL (hosting platforms) or the separate DB_* values below.
# DATABASE_URL=postgres://user:password@host:5432/school_attendance
# DB_SSL=true when the database requires SSL (most external cloud connections).
DB_HOST=localhost
DB_PORT=5432
DB_USER=attendance_app
DB_PASSWORD=change-me
DB_NAME=school_attendance
# true = TypeORM creates/updates tables automatically (fine for development).
DB_SYNC=true

# Long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=28800
